DATABASE_URL=postgresql+psycopg://cvm:cvm@cvm_postgres:5432/cvm
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=1800
REDIS_URL=redis://cvm_redis:6379/0
CVM_BASE_URL=https://dados.cvm.gov.br/dados
ADMIN_TOKEN=trocar-token
TUCANO_CVM_TOKEN=trocar-token
ACCESS_TOKEN_TTL_MINUTES=480
LOG_LEVEL=INFO
AMBIENTE=desenvolvimento
ENABLE_PROMETHEUS_METRICS=false
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MCP_PROFILE=analyst
MCP_HTTP_ENABLED=false
MCP_HTTP_REQUIRE_BEARER=true
MCP_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1,127.0.0.1:*
MCP_HTTP_ALLOWED_ORIGINS=
MCP_REQUIRE_TOKEN=false
MCP_TOKEN=
MCP_MAX_ROWS=50
MCP_MAX_PERIODS=20
MCP_TOOL_TIMEOUT_SECONDS=30
MCP_INCLUDE_RAW_DEFAULT=false
ANOS_INICIAIS_DFP=2020,2021,2022
ANOS_INICIAIS_ITR=2020,2021,2022
ANOS_INICIAIS_FRE=2020,2021,2022
INGESTION_V2_ENABLED=true
INGESTION_V2_PROMOTE_ENABLED=true
ANALISE_MATERIALIZACAO_MAX_ACTIVE_CAMPAIGNS=1
ANALISE_MATERIALIZACAO_MAX_ACTIVE_CHUNKS_PER_CAMPAIGN=1
ANALISE_FUNDAMENTALISTA_SNAPSHOT_ENABLED=true
ANALISE_FUNDAMENTALISTA_PREWARM_ENABLED=true
ANALISE_FUNDAMENTALISTA_CACHE_ENABLED=true
ANALISE_FUNDAMENTALISTA_CACHE_TTL_SECONDS=21600
ANALISE_FUNDAMENTALISTA_RUNTIME_CACHE_TTL_SECONDS=60
ANALISE_FUNDAMENTALISTA_CACHE_LOCK_SECONDS=120
ANALISE_FUNDAMENTALISTA_CACHE_WAIT_SECONDS=15
ANALISE_FUNDAMENTALISTA_HTTP_CACHE_MAX_AGE_SECONDS=60
UPDATES_SERVICE_ENABLED=true
UPDATES_SCANNER_STALE_AFTER_HOURS=36
